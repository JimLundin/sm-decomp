+//! Clocked SPC bus execution: ports are sampled when their bus cycle elapses.
+//!
+//! Independent implementation from the SPC700 bus contract and public S-SMP
+//! timing docs (<https://problemkaputt.de/fullsnes.htm#snesapulowleveltimings>).
+//! The CPU decoder is replayed from the instruction's initial registers using
+//! cached completed reads. Only the next bus operation touches hardware; later
+//! speculative calls are discarded until that operation finishes. This keeps
+//! the existing decoder while allowing an external CPU write during a read.
+use super::{
+    Apu, DSP_BASE_CLOCKS_PER_TICK, Io, MAX_PLAN_BASE_CLOCKS, SaveReader, SaveStateError,
+    SaveWriter, SmpBus, Spc700Bus,
+};
+
+const CAPACITY: usize = 32;
+
+#[derive(Default)]
+pub struct Execution {
+    active: bool,
+    reads: [u8; CAPACITY],
+    completed: usize,
+    pending: Option<Pending>,
+}
+
+#[derive(Clone, Copy)]
+struct Pending {
+    kind: u8, // 0 read, 1 write, 2 idle
+    address: u16,
+    data: u8,
+    remaining: u32,
+    tail: u32,
+    clocks: u32,
+    timer_clocks: u32,
+    elapsed: u32,
+}
+
+struct Resume<'a> {
+    execution: &'a mut Execution,
+    io: &'a Io,
+    cursor: usize,
+    blocked: bool,
+}
+
+impl Resume<'_> {
+    fn operation(&mut self, kind: u8, address: u16, data: u8) -> u8 {
+        if self.blocked {
+            return 0;
+        }
+        if self.cursor < self.execution.completed {
+            let value = self.execution.reads[self.cursor];
+            self.cursor += 1;
+            return value;
+        }
+        assert!(
+            self.cursor < CAPACITY,
+            "SPC instruction bus operation budget"
+        );
+        let half = kind == 0 && address & 0xfffc == 0xf4;
+        let target = if kind == 2 { None } else { Some(address) };
+        let (clocks, timer_clocks) = self.io.wait_clocks(false, target);
+        let tail = if half { clocks / 2 } else { 0 };
+        self.execution.pending = Some(Pending {
+            kind,
+            address,
+            data,
+            remaining: clocks - tail,
+            tail,
+            clocks,
+            timer_clocks,
+            elapsed: 0,
+        });
+        self.blocked = true;
+        0
+    }
+}
+
+impl Spc700Bus for Resume<'_> {
+    fn read(&mut self, address: u16) -> u8 {
+        self.operation(0, address, 0)
+    }
+    fn write(&mut self, address: u16, data: u8) {
+        self.operation(1, address, data);
+    }
+    fn idle(&mut self) {
+        self.operation(2, 0, 0);
+    }
+}
+
+impl Apu {
+    fn resume_clocked_instruction(&mut self) {
+        let mut cpu = self.cpu;
+        let mut bus = Resume {
+            execution: &mut self.clocked,
+            io: &self.io,
+            cursor: 0,
+            blocked: false,
+        };
+        cpu.step(&mut bus);
+        if !bus.blocked {
+            self.cpu = cpu;
+            self.clocked.active = false;
+            self.clocked.completed = 0;
+        }
+    }
+
+    pub(super) fn advance_clocked_smp_cycle(&mut self) {
+        if !self.clocked.active {
+            self.clocked.active = true;
+            self.resume_clocked_instruction();
+        }
+        let Some(mut pending) = self.clocked.pending.take() else {
+            return;
+        };
+        pending.elapsed += 1;
+        let ticks = pending.elapsed * pending.timer_clocks / pending.clocks
+            - (pending.elapsed - 1) * pending.timer_clocks / pending.clocks;
+        for timer in &mut self.timers {
+            timer.step(ticks as u16, self.io.timers_enable, self.io.timers_disable);
+        }
+        self.dsp_counter += 1;
+        if self.dsp_counter >= DSP_BASE_CLOCKS_PER_TICK {
+            self.dsp_counter -= DSP_BASE_CLOCKS_PER_TICK;
+            self.dsp.tick(&mut self.aram);
+        }
+        pending.remaining -= 1;
+        if pending.remaining != 0 {
+            self.clocked.pending = Some(pending);
+            return;
+        }
+        // The first half of a port read samples the latch; its second half
+        // retains that sampled value even if the main CPU writes again.
+        if pending.kind == 0 {
+            let mut bus = self.clocked_io_bus();
+            pending.data = bus
+                .read_io(pending.address)
+                .unwrap_or_else(|| bus.read_ram(pending.address));
+            pending.kind = 3; // sampled read awaiting the remaining half-cycle
+        } else if pending.kind == 1 {
+            let mut bus = self.clocked_io_bus();
+            if bus.io.ram_writable && !bus.io.ram_disable {
+                bus.aram[pending.address as usize] = pending.data;
+            }
+            bus.write_io(pending.address, pending.data);
+        }
+        if pending.tail != 0 {
+            pending.remaining = pending.tail;
+            pending.tail = 0;
+            self.clocked.pending = Some(pending);
+            return;
+        }
+        self.clocked.reads[self.clocked.completed] = pending.data;
+        self.clocked.completed += 1;
+        self.resume_clocked_instruction();
+    }
+
+    fn clocked_io_bus(&mut self) -> SmpBus<'_> {
+        SmpBus {
+            aram: &mut self.aram,
+            dsp: &mut self.dsp,
+            io: &mut self.io,
+            timers: &mut self.timers,
+            iplrom: &self.iplrom,
+            cycles: 0,
+        }
+    }
+}
+
+impl Execution {
+    pub fn save_state(&self, w: &mut SaveWriter) {
+        w.write_bytes(b"CLK1");
+        w.write_bool(self.active);
+        w.write_u8(self.completed as u8);
+        w.write_bytes(&self.reads);
+        w.write_bool(self.pending.is_some());
+        if let Some(p) = self.pending {
+            w.write_u8(p.kind);
+            w.write_u16(p.address);
+            w.write_u8(p.data);
+            for v in [p.remaining, p.tail, p.clocks, p.timer_clocks, p.elapsed] {
+                w.write_u32(v);
+            }
+        }
+    }
+    pub fn load_state(&mut self, r: &mut SaveReader) -> Result<(), SaveStateError> {
+        if r.read_bytes(4)? != b"CLK1" {
+            return Err(SaveStateError::Invalid("clocked SMP state required".into()));
+        }
+        self.active = r.read_bool()?;
+        self.completed = r.read_u8()? as usize;
+        if self.completed >= CAPACITY {
+            return Err(SaveStateError::Invalid("SPC bus operation budget".into()));
+        }
+        self.reads.copy_from_slice(r.read_bytes(CAPACITY)?);
+        self.pending = if r.read_bool()? {
+            let p = Pending {
+                kind: r.read_u8()?,
+                address: r.read_u16()?,
+                data: r.read_u8()?,
+                remaining: r.read_u32()?,
+                tail: r.read_u32()?,
+                clocks: r.read_u32()?,
+                timer_clocks: r.read_u32()?,
+                elapsed: r.read_u32()?,
+            };
+            if p.kind > 3
+                || p.clocks == 0
+                || p.clocks > MAX_PLAN_BASE_CLOCKS
+                || p.remaining == 0
+                || p.remaining > p.clocks
+                || p.elapsed >= p.clocks
+                || p.tail > p.clocks
+                || p.timer_clocks > MAX_PLAN_BASE_CLOCKS
+            {
+                return Err(SaveStateError::Invalid(
+                    "invalid clocked SPC operation".into(),
+                ));
+            }
+            Some(p)
+        } else {
+            None
+        };
+        if self.active != self.pending.is_some() {
+            return Err(SaveStateError::Invalid(
+                "inconsistent clocked SPC state".into(),
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn program(bytes: &[u8]) -> Apu {
+        let mut apu = Apu::new();
+        apu.cpu.regs.pc = 0x0200;
+        apu.aram[0x0200..0x0200 + bytes.len()].copy_from_slice(bytes);
+        apu
+    }
+
+    #[test]
+    fn port_is_sampled_on_its_bus_cycle_and_held_through_the_second_half() {
+        // MOV A,$F4; MOV $F5,A. Opcode/operand fetches take four base clocks;
+        // the read samples on clock five and completes on clock six.
+        for write_at in 0..=6 {
+            let mut apu = program(&[0xe4, 0xf4, 0xc4, 0xf5]);
+            apu.cpu_write_port(0, 0x11);
+            for _ in 0..write_at {
+                apu.advance_smp_cycle();
+            }
+            apu.cpu_write_port(0, 0x22);
+            for _ in write_at..6 {
+                apu.advance_smp_cycle();
+            }
+            let expected = if write_at < 5 { 0x22 } else { 0x11 };
+            assert_eq!(
+                apu.cpu.regs.a, expected,
+                "CPU write after base clock {write_at}"
+            );
+            for _ in 0..7 {
+                apu.advance_smp_cycle();
+            }
+            assert_eq!(
+                apu.cpu_read_port(1),
+                0,
+                "port write must wait for the write cycle"
+            );
+            apu.advance_smp_cycle();
+            assert_eq!(apu.cpu_read_port(1), expected);
+        }
+    }
+
+    #[test]
+    fn compare_uses_the_port_value_at_the_read_cycle() {
+        // CMP Y,$F4: a different destination/ALU path than MOV.
+        let mut apu = program(&[0x7e, 0xf4]);
+        apu.cpu.regs.y = 0x22;
+        apu.cpu_write_port(0, 0x11);
+        for _ in 0..4 {
+            apu.advance_smp_cycle();
+        }
+        apu.cpu_write_port(0, 0x22);
+        for _ in 0..2 {
+            apu.advance_smp_cycle();
+        }
+        assert!(apu.cpu.regs.psw.z());
+        assert!(apu.cpu.regs.psw.c());
+    }
+
+    #[test]
+    fn mid_read_state_preserves_the_sampled_value_and_pending_write() {
+        let mut apu = program(&[0xe4, 0xf4, 0xc4, 0xf5]);
+        apu.cpu_write_port(0, 0x11);
+        for _ in 0..5 {
+            apu.advance_smp_cycle();
+        }
+        let mut writer = SaveWriter::new();
+        apu.save_state(&mut writer);
+        let mut restored = Apu::new();
+        restored
+            .load_state(&mut SaveReader::new(writer.as_bytes()))
+            .unwrap();
+        for machine in [&mut apu, &mut restored] {
+            machine.cpu_write_port(0, 0x22);
+            for _ in 0..9 {
+                machine.advance_smp_cycle();
+            }
+            assert_eq!(machine.cpu_read_port(1), 0x11);
+        }
+        let mut left = SaveWriter::new();
+        let mut right = SaveWriter::new();
+        apu.save_state(&mut left);
+        restored.save_state(&mut right);
+        assert_eq!(left.as_bytes(), right.as_bytes());
+    }
+}
