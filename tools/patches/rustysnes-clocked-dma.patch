 /// The 65C816's view: route a 24-bit access + drive the master clock in lockstep.
 impl CpuBus for Bus {
+    fn begin_cpu_cycle(&mut self, clocks: u32) {
+        #[cfg(feature = "clocked-dma")]
+        match self.dma_stage {
+            1 => self.dma_stage = 2,
+            2 => {
+                self.dma_stage = 0;
+                // Super Famicom Dev, "Timing", DMA: allow one CPU cycle,
+                // align to the 8-clock divider, run DMA, then resume on a
+                // whole following CPU cycle. Both waits are strictly positive.
+                // https://wiki.superfamicom.org/timing#dma-114
+                let pause = self.clock.master;
+                self.advance_master(8 - (pause & 7) as u32);
+                self.run_gp_dma(self.dma.gp_enable);
+                let elapsed = self.clock.master - pause;
+                self.advance_master(clocks - (elapsed % u64::from(clocks)) as u32);
+            }
+            _ => {}
+        }
+        #[cfg(not(feature = "clocked-dma"))]
+        let _ = clocks;
+    }
