// One synchronous dependency adapter shared by every game-host consumer.
#include "snes/ppu.h"
void PortActualNmiProcessVramWriteQueue(void);
void NMI_ProcessVramWriteQueue(void) {
 callbacks++;CallbackSnapshot("before");
 fprintf(callback_log,"vram-begin %lu\n",callbacks);
 PortActualNmiProcessVramWriteQueue();
 fprintf(callback_log,"vram-end %lu\n",callbacks);
 CallbackSnapshot("after");
}
int32_t sm_rust_flush_vram(uint8_t *ram,size_t len) {
 if(!ram||len!=sizeof(g_ram)||ram==g_ram)return -1;
 memcpy(g_ram,ram,len);NMI_ProcessVramWriteQueue();memcpy(ram,g_ram,len);return 0;
}
void __real_WriteReg(uint16,uint8);
void __wrap_WriteReg(uint16 address,uint8 value) {
 if(callback_log)fprintf(callback_log,"register %u %u\n",address,value);
 __real_WriteReg(address,value);
}
void __real_ppu_write(Ppu*,uint8_t,uint8_t);
void __wrap_ppu_write(Ppu *ppu,uint8_t address,uint8_t value) {
 if(callback_log)fprintf(callback_log,"ppu %u %u %u\n",ppu==g_snes->my_ppu,address,value);
 __real_ppu_write(ppu,address,value);
}
uint8_t __real_snes_read(Snes*,uint32_t);
uint8_t __wrap_snes_read(Snes *snes,uint32_t address) {
 uint8_t value=__real_snes_read(snes,address);
 if(callback_log)fprintf(callback_log,"bus-read %u %u\n",address,value);
 return value;
}
void __real_snes_write(Snes*,uint32_t,uint8_t);
void __wrap_snes_write(Snes *snes,uint32_t address,uint8_t value) {
 if(callback_log)fprintf(callback_log,"bus-write %u %u\n",address,value);
 __real_snes_write(snes,address,value);
}
