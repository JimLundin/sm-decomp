extern void C___SYMBOL__(void);
void __SYMBOL__(void) {
 int outer=port_call_depth++==0;
 unsigned long capture=outer?++port_outer_hits[__INDEX__]:0;
 int active=__ACTIVE__;
 unsigned material=outer && active && port_frame_captures[__INDEX__]<8?++port_frame_captures[__INDEX__]:0;
 if(outer && capture<=8)PortCapture(__INDEX__,capture,"before");
 if(material)PortFrameCapture("__SYMBOL__",material,"before");
 int64_t result=-2;
 if(port_mixed)result=__ABI__(g_ram,sizeof(g_ram),g_rom,g_snes->cart->romSize,__ROUTINE__,0,0);
 if(result==-2){port_c_hits[__INDEX__]++;port_frame_refused[__INDEX__]+=port_mixed;port_frame_active_c[__INDEX__]+=active;C___SYMBOL__();}
 else {if(result<0){fprintf(stderr,"accepted frame error __SYMBOL__\n");exit(4);}port_rust_hits[__INDEX__]++;port_frame_active_rust[__INDEX__]+=active;}
 port_call_depth--;
 if(outer){
  if(capture<=8)PortCapture(__INDEX__,capture,"after");
  if(material)PortFrameCapture("__SYMBOL__",material,"after");
  fprintf(port_calls,"__INDEX__ %lu 0 0 0\n",capture);
 }
}
