#include <stdarg.h>
#include <unistd.h>
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <signal.h>
#include <time.h>
#include <limits.h>
#include <string.h>
static FILE *port_effects;
static struct {
 int fd,enabled,opened,finished,failed;
 uint64_t bytes,flushes,writes,elapsed,max,shorts,interruptions;
 const char *path;
 char buffer[65536];
} port_effect_metrics;
static uint64_t PortEffectClock(void) {
 struct timespec now;
 if(clock_gettime(CLOCK_MONOTONIC,&now)){port_effect_metrics.failed=1;return 0;}
 return (uint64_t)now.tv_sec*1000000000u+(uint64_t)now.tv_nsec;
}
static int PortEffectReceipt(void) {
 if(!port_effect_metrics.path)return 0;
 char temporary[PATH_MAX];
 int n=snprintf(temporary,sizeof(temporary),"%s.pending-%ld",port_effect_metrics.path,(long)getpid());
 if(n<0||(size_t)n>=sizeof(temporary))return -1;
 FILE *out=fopen(temporary,"wb");if(!out)return -1;
 int result=fprintf(out,
  "format = \"pipeline-producer-metrics-v1\"\nenabled = %s\nbuffer_bytes = 65536\n"
  "transport_bytes = %" PRIu64 "\nflush_count = %" PRIu64 "\nwrite_calls = %" PRIu64 "\n"
  "write_elapsed_ns = %" PRIu64 "\nmax_flush_ns = %" PRIu64 "\nshort_writes = %" PRIu64 "\ninterruptions = %" PRIu64 "\n"
  "outcome = \"%s\"\n",
  port_effect_metrics.enabled?"true":"false",port_effect_metrics.bytes,port_effect_metrics.flushes,
  port_effect_metrics.writes,port_effect_metrics.elapsed,port_effect_metrics.max,
  port_effect_metrics.shorts,port_effect_metrics.interruptions,
  port_effect_metrics.finished&&!port_effect_metrics.failed?"success":"failed");
 if(port_effect_metrics.failed||!port_effect_metrics.finished)
  if(fputs("error = \"text producer did not finish its effect stream\"\n",out)==EOF)result=-1;
 if(fflush(out)||fsync(fileno(out)))result=-1;
 if(fclose(out))result=-1;
 if(result<0){unlink(temporary);return -1;}
 if(rename(temporary,port_effect_metrics.path)){unlink(temporary);return -1;}
 char parent[PATH_MAX];
 n=snprintf(parent,sizeof(parent),"%s",port_effect_metrics.path);
 if(n<0||(size_t)n>=sizeof(parent))return -1;
 char *slash=strrchr(parent,'/');if(slash==parent)slash[1]=0;else *slash=0;
 int directory=open(parent,O_RDONLY|O_DIRECTORY);if(directory<0)return -1;
 result=fsync(directory);if(close(directory))result=-1;
 if(result)return -1;
 return 0;
}
static void PortEffectExit(void) {
 if(port_effect_metrics.opened&&!port_effect_metrics.finished){
  port_effect_metrics.failed=1;
  if(port_effects){(void)fclose(port_effects);port_effects=NULL;}
  (void)PortEffectReceipt();
 }
}
static ssize_t PortEffectWrite(void *cookie,const char *bytes,size_t length) {
 (void)cookie;
 size_t offset=0;
 while(offset<length){
  size_t batch=length-offset;if(batch>sizeof(port_effect_metrics.buffer))batch=sizeof(port_effect_metrics.buffer);
  size_t end=offset+batch;
  uint64_t started=port_effect_metrics.enabled?PortEffectClock():0;
  port_effect_metrics.flushes++;
  while(offset<end){
   port_effect_metrics.writes++;
   ssize_t written=write(port_effect_metrics.fd,bytes+offset,end-offset);
   if(written<0){if(errno==EINTR){port_effect_metrics.interruptions++;continue;}port_effect_metrics.failed=1;break;}
   if(written==0){errno=EIO;port_effect_metrics.failed=1;break;}
   if((size_t)written<end-offset)port_effect_metrics.shorts++;
   offset+=(size_t)written;port_effect_metrics.bytes+=(uint64_t)written;
  }
  if(port_effect_metrics.enabled){
   uint64_t ended=PortEffectClock(),elapsed=ended>=started?ended-started:0;
   port_effect_metrics.elapsed+=elapsed;if(elapsed>port_effect_metrics.max)port_effect_metrics.max=elapsed;
  }
  if(offset<end)break;
 }
 /* GNU cookie writes report zero on error; partial bytes remain diagnostic. */
 return offset==length?(ssize_t)length:0;
}
static int PortEffectCloseCookie(void *cookie) {
 (void)cookie;
 int result=close(port_effect_metrics.fd);port_effect_metrics.fd=-1;
 if(result)port_effect_metrics.failed=1;
 return result;
}
static FILE *PortEffectsOpen(void) {
 const char *mode=getenv("SM_PIPELINE_METRICS");
 port_effect_metrics.enabled=mode&&!strcmp(mode,"enabled");
 port_effect_metrics.path=getenv("SM_PIPELINE_METRICS_PRODUCER_PATH");
 if(port_effect_metrics.path&&port_effect_metrics.path[0]!='/'){errno=EINVAL;return NULL;}
 port_effect_metrics.opened=1;
 if(atexit(PortEffectExit)){port_effect_metrics.failed=1;(void)PortEffectReceipt();return NULL;}
 if(mode&&strcmp(mode,"enabled")&&strcmp(mode,"disabled")){errno=EINVAL;return NULL;}
 const char *pipe=getenv("SM_EVIDENCE_PIPE");if(!pipe){errno=EINVAL;return NULL;}
 if(signal(SIGPIPE,SIG_IGN)==SIG_ERR)return NULL;
 port_effect_metrics.fd=open(pipe,O_WRONLY|O_CREAT|O_TRUNC,0666);
 if(port_effect_metrics.fd<0)return NULL;
 cookie_io_functions_t io={.read=NULL,.write=PortEffectWrite,.seek=NULL,.close=PortEffectCloseCookie};
 FILE *stream=fopencookie(NULL,"w",io);
 if(!stream){close(port_effect_metrics.fd);return NULL;}
 if(setvbuf(stream,port_effect_metrics.buffer,_IOFBF,sizeof(port_effect_metrics.buffer))){fclose(stream);return NULL;}
 return stream;
}
static void PortEffect(FILE *stream,const char *format,...) {
 va_list args;va_start(args,format);int n=vfprintf(stream,format,args);va_end(args);
 if(n<0||ferror(stream)||port_effect_metrics.failed){port_effect_metrics.failed=1;exit(2);}
}
static int PortEffectsClose(void) {
 int result=fclose(port_effects);port_effects=NULL;
 if(result)port_effect_metrics.failed=1;
 port_effect_metrics.finished=1;
 if(PortEffectReceipt())result=-1;
 return result||port_effect_metrics.failed?-1:0;
}
