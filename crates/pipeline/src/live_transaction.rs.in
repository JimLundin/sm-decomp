// Shared only by the bounded live adapters. Ordinary families execute directly.
mod live_transaction {
    use super::{Wram, WRAM_SIZE};
    use std::{cell::RefCell, panic::{AssertUnwindSafe, catch_unwind}};

    thread_local! {
        // A checked-out buffer leaves the pool before any gameplay or callback.
        // Nested synchronous entries therefore get separate storage, and each
        // thread retains only the buffers needed by its maximum nesting depth.
        static SCRATCH: RefCell<Vec<Vec<u8>>> = const { RefCell::new(Vec::new()) };
    }

    struct Scratch(Option<Vec<u8>>);
    impl Scratch {
        fn take() -> Self {
            Self(Some(SCRATCH.try_with(|pool| pool.borrow_mut().pop()).ok().flatten()
                .unwrap_or_else(|| vec![0; WRAM_SIZE])))
        }
    }
    impl Drop for Scratch {
        fn drop(&mut self) {
            if let Some(bytes) = self.0.take() {
                // Thread teardown must not cause another panic during unwind.
                let _ = SCRATCH.try_with(|pool| pool.borrow_mut().push(bytes));
            }
        }
    }

    // Callers first validate full extent and separation from ROM/host. The
    // selector receives only immutable Wram access, cannot publish state, and
    // must not invoke a native callback while this short borrow is alive.
    pub unsafe fn inspect<T>(ram: *mut u8, select: impl FnOnce(&Wram<'_>) -> Result<T, &'static str>) -> Result<T, ()> {
        catch_unwind(AssertUnwindSafe(|| {
            let bytes = unsafe { std::slice::from_raw_parts_mut(ram, WRAM_SIZE) };
            select(&Wram::new(bytes)?)
        })).map_err(|_| ())?.map_err(|_| ())
    }

    // Full WRAM is the transaction unit. Success alone publishes it; selector
    // refusal, dispatch error and panic cannot leak private partial writes.
    pub unsafe fn run<T>(ram: *mut u8, call: impl FnOnce(&mut [u8]) -> Result<T, &'static str>) -> Result<T, ()> {
        catch_unwind(AssertUnwindSafe(|| {
            let mut scratch = Scratch::take();
            let bytes = scratch.0.as_mut().unwrap();
            bytes.copy_from_slice(unsafe { std::slice::from_raw_parts(ram, WRAM_SIZE) });
            let value = call(bytes)?;
            unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), ram, WRAM_SIZE); }
            Ok(value)
        })).map_err(|_| ())?.map_err(|_: &'static str| ())
    }

    // An ordered observer gets a separate immutable snapshot. Keeping the
    // private transaction borrowed here never exposes its storage to native C.
    pub fn observe(state: &Wram<'_>, observe: impl FnOnce(&[u8])) {
        let mut scratch = Scratch::take();
        let bytes = scratch.0.as_mut().unwrap();
        for (i, byte) in bytes.iter_mut().enumerate() { *byte = state.byte(i); }
        observe(bytes);
    }
}
