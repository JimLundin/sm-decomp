<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <title>Super Metroid · Translation progress</title>
  <style>
    :root { color-scheme: dark; --bg:#10151a; --panel:#171e25; --raised:#1d2730; --ink:#e7edf1; --muted:#9baab7; --line:#2c3944; --accent:#85d9c3; --accent-bg:#173d35; --warning:#eac778; --warning-bg:#362e1c; --unreported:#42505c; --translating:#d8af65; --translated:#69b99e; --verified:#70b8cf; --integrated:#929edf; --live:#b09ee0; --shadow:0 8px 32px #0002; }
    :root[data-theme="light"] { color-scheme:light; --bg:#f0f3f3; --panel:#fff; --raised:#f6f8f8; --ink:#182931; --muted:#536774; --line:#d3dfe1; --accent:#176c58; --accent-bg:#e1f2ec; --warning:#765316; --warning-bg:#fff3d9; --unreported:#b2c0c5; --translating:#b38228; --translated:#3b916f; --verified:#397f9e; --integrated:#6975be; --live:#8c64b4; --shadow:0 8px 32px #24404a09; }
    @media(prefers-color-scheme:light) { :root:not([data-theme="dark"]) { color-scheme:light; --bg:#f0f3f3; --panel:#fff; --raised:#f6f8f8; --ink:#182931; --muted:#536774; --line:#d3dfe1; --accent:#176c58; --accent-bg:#e1f2ec; --warning:#765316; --warning-bg:#fff3d9; --unreported:#b2c0c5; --translating:#b38228; --translated:#3b916f; --verified:#397f9e; --integrated:#6975be; --live:#8c64b4; --shadow:0 8px 32px #24404a09; } }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--ink); font:15px/1.5 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    button,input,select { font:inherit; }
    button,select,input[type="search"] { color:var(--ink); background:var(--panel); border:1px solid var(--line); border-radius:7px; min-height:39px; }
    button { cursor:pointer; padding:8px 13px; }
    button:hover { background:var(--raised); border-color:var(--muted); }
    button:disabled { opacity:.45; cursor:default; }
    a { color:var(--accent); text-underline-offset:3px; overflow-wrap:anywhere; }
    :focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
    .shell { max-width:1500px; margin:auto; padding:28px 40px 44px; }
    .topbar { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:34px; }
    .identity { display:flex; align-items:center; gap:13px; }
    .mark { display:grid; place-items:center; height:39px; width:39px; border:1px solid var(--accent); border-radius:9px; font:700 12px/1 ui-monospace,monospace; letter-spacing:-.5px; color:var(--accent); }
    .eyebrow { font-size:11px; font-weight:700; letter-spacing:1.6px; text-transform:uppercase; color:var(--muted); }
    .top-title { font-size:14px; font-weight:650; }
    .actions { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
    .primary { background:var(--accent-bg); color:var(--accent); border-color:var(--accent); }
    .intro { display:flex; justify-content:space-between; gap:30px; align-items:flex-start; margin-bottom:22px; }
    h1 { font-size:clamp(28px,3.2vw,43px); line-height:1.15; letter-spacing:-1.5px; margin:8px 0 13px; font-weight:680; }
    .description { max-width:760px; color:var(--muted); margin:0; font-size:15px; }
    .sync { text-align:right; padding-top:12px; min-width:190px; font-size:12px; color:var(--muted); }
    .sync strong { color:var(--ink); font-weight:550; display:block; margin-bottom:3px; }
    .dot { width:6px; height:6px; display:inline-block; border-radius:50%; background:var(--accent); margin-right:6px; }
    .notice { border:1px solid var(--line); border-left:3px solid var(--accent); border-radius:8px; padding:12px 16px; margin:20px 0; background:var(--panel); color:var(--muted); font-size:13px; }
    .notice strong { color:var(--ink); }
    .warning { border-left-color:var(--warning); background:var(--warning-bg); color:var(--warning); }
    .error { border-left-color:#da7777; }
    [hidden] { display:none !important; }
    .metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin:24px 0 18px; }
    .metric { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:20px; box-shadow:var(--shadow); }
    .metric-label { color:var(--muted); font-size:12px; font-weight:600; }
    .metric-number { font-size:34px; font-weight:650; line-height:1.25; letter-spacing:-1px; margin:7px 0 3px; font-variant-numeric:tabular-nums; }
    .metric small { color:var(--muted); font-size:12px; }
    .metric.emphasis .metric-number { color:var(--accent); }
    .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; overflow:hidden; margin-top:18px; }
    .panel-head { padding:20px 22px 14px; display:flex; align-items:flex-start; justify-content:space-between; gap:20px; }
    h2 { font-size:17px; letter-spacing:-.25px; margin:0; font-weight:650; }
    .subtext { color:var(--muted); font-size:12px; margin:5px 0 0; }
    .selectors { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
    label { color:var(--muted); font-size:12px; display:block; }
    select { padding:7px 29px 7px 10px; max-width:100%; }
    .selectors label { display:flex; gap:7px; align-items:center; }
    .overview { padding:4px 22px 20px; }
    .stack { height:12px; display:flex; overflow:hidden; border-radius:4px; background:var(--unreported); }
    .segment { min-width:0; height:100%; }
    .legend { display:flex; gap:17px; flex-wrap:wrap; margin-top:12px; font-size:11px; color:var(--muted); }
    .legend-item { display:flex; align-items:center; gap:6px; }
    .swatch { width:8px; height:8px; border-radius:2px; flex:none; }
    .legend-item strong { font-weight:550; color:var(--ink); font-variant-numeric:tabular-nums; }
    .bank-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(155px,1fr)); gap:10px; padding:4px 22px 22px; }
    .bank { text-align:left; padding:12px; background:var(--raised); min-height:97px; position:relative; }
    .bank[aria-pressed="true"] { border-color:var(--accent); box-shadow:0 0 0 1px var(--accent); }
    .bank-label { display:flex; justify-content:space-between; align-items:center; gap:8px; font-size:12px; margin-bottom:12px; }
    .bank-label strong { font:600 13px/1.4 ui-monospace,monospace; }
    .bank-percent { color:var(--accent); font-variant-numeric:tabular-nums; }
    .bank-bar { background:var(--line); height:5px; border-radius:3px; overflow:hidden; }
    .bank-fill { height:100%; background:var(--accent); }
    .bank-count { color:var(--muted); font-size:10px; margin-top:8px; }
    .bank-empty .bank-percent { color:var(--muted); }
    .filters { padding:0 22px 18px; display:grid; grid-template-columns:minmax(210px,2fr) repeat(5,minmax(100px,1fr)); gap:10px; }
    .filters label span { display:block; margin-bottom:5px; }
    .filters select,.filters input { width:100%; }
    input[type="search"] { padding:7px 11px; }
    .list-toolbar { border-top:1px solid var(--line); padding:12px 22px; display:flex; align-items:center; justify-content:space-between; gap:15px; color:var(--muted); font-size:12px; background:var(--raised); }
    .list-toolbar strong { color:var(--ink); }
    .list-toolbar button { min-height:30px; padding:4px 9px; font-size:12px; }
    .list-header,.routine-summary { display:grid; grid-template-columns:minmax(230px,2.6fr) 110px 100px 85px 145px; align-items:center; gap:14px; }
    .list-header { padding:11px 22px; color:var(--muted); border-bottom:1px solid var(--line); font-size:10px; letter-spacing:.7px; text-transform:uppercase; }
    .routine { border-bottom:1px solid var(--line); }
    .routine:last-child { border-bottom:0; }
    .routine-summary { padding:13px 22px; cursor:pointer; list-style:none; font-size:12px; }
    .routine-summary::-webkit-details-marker { display:none; }
    .routine-summary:hover { background:var(--raised); }
    .routine[open] .routine-summary { background:var(--raised); }
    .routine-name { display:flex; align-items:center; gap:9px; min-width:0; }
    .chevron { color:var(--muted); font-size:12px; width:10px; flex:none; transform:rotate(0deg); }
    .routine[open] .chevron { transform:rotate(90deg); }
    .symbol { font:550 12px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace; overflow-wrap:anywhere; }
    .mono { font:12px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace; }
    .muted { color:var(--muted); }
    .number { font-variant-numeric:tabular-nums; }
    .badge { display:inline-flex; align-items:center; gap:6px; border:1px solid var(--line); border-radius:5px; padding:3px 7px; width:fit-content; color:var(--muted); font-size:10px; white-space:nowrap; }
    .badge::before { content:""; width:5px; height:5px; border-radius:50%; background:var(--unreported); }
    .badge[data-stage="translating"]::before { background:var(--translating); }
    .badge[data-stage="translated"]::before { background:var(--translated); }
    .badge[data-stage="verified"]::before { background:var(--verified); }
    .badge[data-stage="integrated"]::before { background:var(--integrated); }
    .badge[data-stage="live-exercised"]::before { background:var(--live); }
    .badge[data-stage]:not([data-stage="unreported"]) { color:var(--ink); }
    .routine-detail { padding:22px 38px 25px; display:grid; grid-template-columns:minmax(220px,1fr) minmax(300px,1.5fr); gap:28px; background:var(--raised); font-size:12px; }
    .detail-title { font-size:11px; font-weight:650; letter-spacing:.7px; text-transform:uppercase; margin:0 0 10px; color:var(--muted); }
    dl { margin:0 0 18px; }
    .detail-pair { display:grid; grid-template-columns:105px 1fr; gap:9px; margin:6px 0; }
    dt { color:var(--muted); }
    dd { margin:0; overflow-wrap:anywhere; }
    .digest { font:10px/1.5 ui-monospace,monospace; overflow-wrap:anywhere; color:var(--muted); }
    .chips { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:18px; }
    .chip { font:10px/1.5 ui-monospace,monospace; min-height:25px; padding:3px 7px; background:var(--panel); max-width:100%; overflow-wrap:anywhere; }
    .path-list { margin:0 0 18px; padding-left:17px; }
    .path-list li { margin:5px 0; overflow-wrap:anywhere; }
    .observation { padding:13px 15px; background:var(--panel); border:1px solid var(--line); border-radius:7px; margin-bottom:9px; }
    .observation-head { display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:8px; }
    .observation p { margin:6px 0; }
    .observation ul { margin:8px 0 0; padding-left:17px; }
    .stale-tag { color:var(--warning); font-size:10px; font-weight:600; }
    .observation[data-stale="true"] .badge { color:var(--muted); }
    .observation[data-stale="true"] .badge::before { background:var(--unreported); }
    .empty { text-align:center; color:var(--muted); padding:50px 20px; }
    .pagination { border-top:1px solid var(--line); padding:14px 22px; display:flex; justify-content:space-between; align-items:center; gap:15px; font-size:12px; color:var(--muted); }
    .pagination-actions { display:flex; align-items:center; gap:12px; }
    .pagination button { min-height:33px; font-size:12px; padding:5px 11px; }
    .provenance { margin-top:23px; border:1px solid var(--line); border-radius:8px; }
    .provenance summary { cursor:pointer; padding:13px 16px; font-size:12px; font-weight:600; color:var(--muted); }
    .provenance-content { padding:0 16px 16px; font-size:12px; max-width:950px; }
    .footer { display:flex; justify-content:space-between; gap:20px; color:var(--muted); font-size:11px; padding-top:20px; }
    .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    @media(min-width:1100px) { .bank-grid { grid-template-columns:repeat(8,1fr); } }
    @media(max-width:1050px) { .shell { padding:24px; } .filters { grid-template-columns:repeat(3,1fr); } .list-header,.routine-summary { grid-template-columns:minmax(180px,2fr) 90px 80px 60px 120px; gap:10px; } .panel-head { flex-wrap:wrap; } }
    @media(max-width:720px) { .shell { padding:20px 14px 30px; } .topbar { align-items:flex-start; margin-bottom:24px; } .top-title { max-width:140px; } .actions { justify-content:flex-end; } .actions button { font-size:12px; padding:6px 9px; min-height:34px; } .intro { display:block; } .sync { text-align:left; padding-top:16px; } .sync strong { display:inline; margin-right:8px; } h1 { letter-spacing:-.8px; } .metrics { grid-template-columns:repeat(2,1fr); gap:10px; } .metric { padding:15px; } .metric-number { font-size:28px; } .panel-head { padding:17px 15px 14px; } .selectors { gap:8px; } .selectors label { font-size:11px; } .selectors select { font-size:11px; min-height:33px; } .overview { padding:2px 15px 17px; } .legend { gap:10px; } .bank-grid { padding:0 15px 17px; grid-template-columns:repeat(3,1fr); gap:7px; } .bank { padding:10px; min-height:88px; } .bank-label { font-size:10px; } .bank-label strong { font-size:11px; } .bank-count { font-size:9px; } .filters { grid-template-columns:repeat(2,minmax(0,1fr)); padding:0 15px 15px; } .filter-search { grid-column:1 / -1; } .list-toolbar { padding:11px 15px; } .list-header { display:none; } .routine-summary { grid-template-columns:1fr auto; gap:8px; padding:14px 15px; } .routine-name { grid-column:1 / -1; } .routine-source { grid-column:1; font-size:10px; } .routine-address { grid-column:1; grid-row:3; font-size:10px; } .routine-lines { display:none; } .routine-stage { grid-column:2; grid-row:2 / 4; } .routine-detail { padding:19px 20px; grid-template-columns:minmax(0,1fr); gap:10px; } .pagination { padding:14px 15px; } .footer { display:block; } .footer span { display:block; margin-bottom:7px; } }
    @media(prefers-reduced-motion:no-preference) { .bank-fill { transition:width .25s ease; } }
    @media print { .actions,.filters,.pagination,.sync { display:none; } .shell { padding:0; } .panel,.metric { break-inside:avoid; } }
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="identity"><div class="mark" aria-hidden="true">SM</div><div><div class="eyebrow">Decompilation</div><div class="top-title">Translation progress</div></div></div>
      <div class="actions"><button id="theme" type="button" aria-label="Change color theme">Theme</button><button id="load" class="primary" type="button">Open registry JSON</button><input id="file" type="file" accept="application/json,.json" hidden></div>
    </header>
    <section class="intro" aria-labelledby="title">
      <div><div class="eyebrow">Shared routine inventory</div><h1 id="title">Every routine. A visible next step.</h1><p class="description">An inventory of the original C definitions, with agent reports attached to the work they describe. Explore the source banks, see what remains, and inspect the evidence behind each observation.</p></div>
      <div class="sync"><strong id="sync-mode"><span class="dot" aria-hidden="true"></span>Embedded snapshot</strong><span id="updated"></span><br><span id="checked"></span></div>
    </section>
    <div id="error" class="notice error" role="alert" hidden></div>
    <section class="metrics" aria-label="Inventory overview">
      <div class="metric"><div class="metric-label">Original C definitions</div><div class="metric-number" id="total">—</div><small id="total-lines">Inventory body lines</small></div>
      <div class="metric emphasis"><div class="metric-label" id="reported-label">Reported translated</div><div class="metric-number" id="reported">—</div><small id="reported-lines">Current observations only</small></div>
      <div class="metric"><div class="metric-label" id="remaining-label">Remaining before translation report</div><div class="metric-number" id="remaining">—</div><small id="remaining-lines">Definitions without that observation</small></div>
      <div class="metric"><div class="metric-label">Declared in fixtures</div><div class="metric-number" id="declared">—</div><small id="declared-lines">Declarations only · no verification inferred</small></div>
    </section>
    <section class="panel" aria-labelledby="banks-title">
      <div class="panel-head"><div><h2 id="banks-title">Progress across source banks</h2><p class="subtext">Exact reported stage · stages do not imply one another. Select a bank to explore its routines.</p></div><div class="selectors"><label for="milestone">Reported stage <select id="milestone"><option value="translated">Translated</option><option value="verified">Verified</option><option value="integrated">Integrated</option><option value="live-exercised">Live exercised</option><option value="translating">Translating</option></select></label><label for="weight">Weight by <select id="weight"><option value="routines">Definitions</option><option value="lines">Body lines</option></select></label></div></div>
      <div class="overview"><label for="context">Evidence context <select id="context"><option value="">All reported contexts</option><option value="current-checkout">Checkout at observation</option><option value="historical-frozen">Retained historical source</option><option value="unspecified">Unspecified / legacy</option></select></label><p id="context-counts" class="subtext"></p><div id="stack" class="stack" role="img" aria-label="Selected stage observation coverage"></div><div id="legend" class="legend"></div><p class="subtext">Legend counts each stage independently. A definition may have reports in several stages and evidence contexts. Inventory coverage does not establish full-game completion.</p></div>
      <div id="banks" class="bank-grid"></div>
    </section>
    <section class="panel" aria-labelledby="routines-title">
      <div class="panel-head"><div><h2 id="routines-title">Routine explorer</h2><p class="subtext">Expand a definition for dependencies, declarations, scopes, and every reported update.</p></div></div>
      <div class="filters">
        <label class="filter-search"><span>Symbol or original address</span><input id="search" type="search" placeholder="Search routines, e.g. Samus or 0x90…" autocomplete="off"></label>
        <label><span>Source bank</span><select id="bank"><option value="">All banks</option></select></label>
        <label><span>Subsystem*</span><select id="subsystem"><option value="">All subsystems</option></select></label>
        <label><span>Highest reported stage</span><select id="stage"><option value="">All stages</option><option value="remaining">Missing selected stage report</option><option value="unreported">No matching report</option><option value="translating">Translating</option><option value="translated">Translated</option><option value="verified">Verified</option><option value="integrated">Integrated</option><option value="live-exercised">Live exercised</option><option value="stale">Stale reports only</option></select></label>
        <label><span>Reporting agent</span><select id="agent"><option value="">All agents</option></select></label>
        <label><span>Translation scope</span><select id="scope"><option value="">All scopes</option></select></label>
      </div>
      <div class="list-toolbar"><span id="results" role="status" aria-live="polite">Loading inventory…</span><div class="actions"><button id="show-remaining" type="button">Show remaining</button><button id="reset" type="button">Reset filters</button></div></div>
      <div class="list-header" aria-hidden="true"><span>Routine</span><span>Source</span><span>Address</span><span>Body lines</span><span>Observation</span></div>
      <div id="routines"></div>
      <div class="pagination"><span id="page-info"></span><div class="pagination-actions"><button id="previous" type="button">← Previous</button><span id="page"></span><button id="next" type="button">Next →</button></div></div>
    </section>
    <details id="report-details" class="provenance"><summary>Report details <span id="report-detail-count" class="muted"></span></summary><div class="provenance-content"><p><strong>Reported progress, with its limits.</strong> Stages describe agent observations against the current C inventory. Evidence may describe retained historical Rust source or the checkout at observation; select its context above. Fixture declarations do not establish verification. Counts and body lines measure inventory coverage; they do not establish full-game completion.</p><div id="notices" class="notice warning" hidden></div><div id="provenance"></div></div></details>
    <footer class="footer"><span>* Subsystems are navigation hints derived from routine names; source banks and reported scopes remain explicit.</span><span>Standalone HTML · embedded data works offline · served reports check registry.json every 7 seconds</span></footer>
  </main>
  <script id="progress-data" type="application/json">__PROGRESS_JSON__</script>
  <script>
  (() => {
    'use strict';
    const $ = id => document.getElementById(id);
    const STAGES = ['unreported', 'translating', 'translated', 'verified', 'integrated', 'live-exercised'];
    const LABELS = { unreported:'No matching report', translating:'Translating', translated:'Translated', verified:'Verified', integrated:'Integrated', 'live-exercised':'Live exercised' };
    const COLORS = { unreported:'--unreported', translating:'--translating', translated:'--translated', verified:'--verified', integrated:'--integrated', 'live-exercised':'--live' };
    const PAGE_SIZE = 60;
    const state = { data:null, rows:[], symbols:new Map(), page:0, expanded:new Set(), raw:'', file:false, checked:null };
    const fmt = n => Number(n || 0).toLocaleString();
    const percent = (part,total) => total ? (part / total * 100).toFixed(part && part / total < .01 ? 2 : 1) + '%' : '0%';
    const time = value => { const date = new Date(Number(value) * 1000); return Number.isFinite(date.getTime()) ? date.toLocaleString(undefined,{dateStyle:'medium',timeStyle:'short'}) : 'Unknown'; };
    const el = (tag,className,text) => { const node = document.createElement(tag); if(className) node.className=className; if(text !== undefined) node.textContent=String(text); return node; };
    const text = (id,value) => { $(id).textContent=value; };
    const list = value => Array.isArray(value) ? value : [];
    const rank = stage => STAGES.indexOf(stage);
    const contextOf = update => update.evidence_context || 'unspecified';
    const contextLabel = context => ({'current-checkout':'Checkout at observation','historical-frozen':'Retained historical source',unspecified:'Unspecified / legacy'}[context] || context);
    const selectedUpdates = row => row.current.filter(update => !$('context').value || contextOf(update)===$('context').value);
    const selectedStages = row => new Set(selectedUpdates(row).map(update => update.stage));
    const selectedHighest = row => selectedUpdates(row).reduce((stage,update) => rank(update.stage)>rank(stage) ? update.stage : stage,'unreported');
    const lines = row => Math.max(0,Number(row.body_lines) || 0);
    const weight = row => $('weight').value === 'lines' ? lines(row) : 1;
    const bankOf = row => { const match=String(row.source || '').match(/(?:^|\/)sm_([0-9a-f]{2})(?:\.|_)/i); if(match) return match[1].toUpperCase(); const address=String(row.original_address || '').replace(/^0x/i,''); return /^[0-9a-f]{6}$/i.test(address) ? address.slice(0,2).toUpperCase() : 'Other'; };
    function subsystemOf(row) {
      const name=String(row.symbol || '');
      if(/Eproj|EnemyProjectile/i.test(name)) return 'Enemy projectiles';
      if(/Plm|Door|RoomState|RoomTransition/i.test(name)) return 'Rooms & PLMs';
      if(/Samus|Grapple|Bomb|Shinespark|Suit|Player/i.test(name)) return 'Samus & equipment';
      if(/Enemy|Ridley|Kraid|MotherBrain|Phantoon|Draygon|Crocomire|SporeSpawn|Botwoon|Torizo|Metroid/i.test(name)) return 'Enemies & bosses';
      if(/Projectile|Missile|Beam/i.test(name)) return 'Player projectiles';
      if(/Music|Sound|Audio|Sfx|Apu/i.test(name)) return 'Audio';
      if(/Menu|Pause|Map|Hud|Text|Message|FileSelect|Title|Ending|Intro|Demo/i.test(name)) return 'Menus & presentation';
      if(/Dma|Ppu|Vram|Sprite|Palette|Scroll|Hdma|Draw|Tile|Fx|Screen/i.test(name)) return 'Graphics & hardware';
      return 'Other routines';
    }
    function stale(update) {
      const source=state.data.source || {};
      return Boolean(list(state.data.stale_update_ids).includes(update.id) || (update.source_revision && source.revision && update.source_revision !== source.revision) || (update.inventory_sha256 && source.inventory_sha256 && update.inventory_sha256 !== source.inventory_sha256));
    }
    function replacements(update) { return state.data.updates.filter(candidate => list(candidate.supersedes).includes(update.id)); }
    function superseded(update) { return list(state.data.superseded_update_ids).includes(update.id) || replacements(update).length>0; }
    function excluded(update) { return stale(update) || superseded(update); }
    function safeLink(path,base) {
      if(typeof path !== 'string' || !path || /[\u0000-\u001f]/.test(path) || /^(?:javascript|data|vbscript):/i.test(path)) return null;
      try {
        if(path.startsWith('/')) return new URL('file://' + path).href;
        if(/^(?:https?|file):\/\//i.test(path)) return new URL(path).href;
        if(/^[a-z][a-z0-9+.-]*:/i.test(path)) return null;
        if(base && String(base).startsWith('/')) return new URL(path,'file://' + String(base).replace(/\/$/,'') + '/').href;
        return new URL(path,location.href).href;
      } catch { return null; }
    }
    function pathNode(path,base,label) {
      const href=safeLink(String(path || ''),base);
      const node=el(href ? 'a' : 'span','mono',label === undefined ? path : label);
      if(href) { node.href=href; node.target='_blank'; node.rel='noopener'; }
      return node;
    }
    function pair(dl,label,value) { const wrapper=el('div','detail-pair'); wrapper.append(el('dt','',label)); const dd=el('dd'); dd.append(value instanceof Node ? value : document.createTextNode(String(value ?? 'Not recorded'))); wrapper.append(dd); dl.append(wrapper); }
    function badge(stage) { const node=el('span','badge',LABELS[stage] || stage); node.dataset.stage=stage; return node; }
    function fillOptions(id,values,label) {
      const select=$(id), previous=select.value; select.replaceChildren(new Option(label,''));
      for(const value of [...new Set(values.filter(Boolean).map(String))].sort()) select.add(new Option(value,value));
      if(previous && ![...select.options].some(option => option.value === previous)) select.add(new Option(previous + ' (not in snapshot)',previous));
      select.value=previous;
    }
    function accept(data,raw,file) {
      if(!data || data.schema_version !== 1 || !Array.isArray(data.routines) || !Array.isArray(data.updates)) throw new Error('This file is not a schema version 1 progress registry.');
      if(data.routines.some(row => !row || typeof row.symbol !== 'string' || typeof row.source !== 'string') || data.updates.some(update => !update || typeof update !== 'object')) throw new Error('The registry contains malformed routine or update records.');
      state.data=data; state.raw=raw; state.file=file; const bySymbol=new Map();
      for(const update of data.updates) for(const symbol of list(update.routines)) { if(!bySymbol.has(symbol)) bySymbol.set(symbol,[]); bySymbol.get(symbol).push(update); }
      state.rows=data.routines.map(row => {
        const updates=(bySymbol.get(row.symbol) || []).slice().sort((a,b) => Number(b.updated_at || 0) - Number(a.updated_at || 0));
        const current=updates.filter(update => !excluded(update));
        const highest=current.reduce((stage,update) => rank(update.stage) > rank(stage) ? update.stage : stage,'unreported');
        return {...row,bank:bankOf(row),subsystem:subsystemOf(row),updates,current,highest,stages:new Set(current.map(update => update.stage))};
      }).sort((a,b) => a.bank.localeCompare(b.bank) || String(a.source).localeCompare(String(b.source)) || Number(a.line)-Number(b.line) || a.symbol.localeCompare(b.symbol));
      state.symbols=new Map(state.rows.map(row => [row.symbol,row]));
      fillOptions('bank',state.rows.map(row => row.bank),'All banks');
      fillOptions('subsystem',state.rows.map(row => row.subsystem),'All subsystems');
      fillOptions('agent',data.updates.map(update => update.agent),'All agents');
      fillOptions('scope',data.updates.map(update => update.scope),'All scopes');
      $('error').hidden=true; renderOverview(); renderList(); renderProvenance();
      text('updated','Snapshot: ' + time(data.updated_at));
      const mode=file ? 'Opened JSON snapshot' : /^https?:$/.test(location.protocol) ? 'Live registry · 7s checks' : 'Embedded snapshot · offline';
      $('sync-mode').replaceChildren(el('span','dot'),document.createTextNode(mode));
      const warnings=list(data.notices).map(String); const staleCount=data.updates.filter(stale).length;
      if(staleCount) warnings.push(fmt(staleCount) + ' update(s) have stale source, inventory, or evidence. They remain visible in routine details and are excluded from current coverage.');
      $('notices').hidden=!warnings.length; $('notices').replaceChildren();
      text('report-detail-count',warnings.length ? '· '+fmt(warnings.length)+' notices' : '');
      if(warnings.length) { const ul=el('ul'); ul.style.margin='0'; ul.style.paddingLeft='18px'; for(const warning of warnings) ul.append(el('li','',warning)); $('notices').append(ul); }
    }
    function renderOverview() {
      if(!state.data) return;
      const target=$('milestone').value, reached=state.rows.filter(row => selectedStages(row).has(target)), outstanding=state.rows.filter(row => !selectedStages(row).has(target)), declared=state.rows.filter(row => list(row.declared_in).length);
      const contextCounts=['current-checkout','historical-frozen','unspecified'].map(context => contextLabel(context)+': '+fmt(state.rows.filter(row => row.current.some(update => update.stage===target && contextOf(update)===context)).length));
      text('context-counts',LABELS[target]+' definitions by evidence context · '+contextCounts.join(' · ')+' · contexts can overlap');
      const bodyTotal=state.rows.reduce((sum,row) => sum+lines(row),0), reachedLines=reached.reduce((sum,row) => sum+lines(row),0), outstandingLines=outstanding.reduce((sum,row) => sum+lines(row),0);
      text('total',fmt(state.rows.length)); text('total-lines',fmt(bodyTotal) + ' C body lines · all definitions');
      text('reported-label','Reported ' + LABELS[target].toLowerCase());
      text('reported',fmt(reached.length)); text('reported-lines',percent(reachedLines,bodyTotal) + ' of body lines · ' + fmt(reachedLines) + ' lines');
      text('remaining-label','Missing selected stage report'); text('remaining',fmt(outstanding.length)); text('remaining-lines',fmt(outstandingLines) + ' body lines without that report');
      text('declared',fmt(declared.length)); text('declared-lines',fmt(declared.reduce((sum,row) => sum+lines(row),0)) + ' body lines · declarations only');
      const counts=Object.fromEntries(STAGES.map(stage => [stage,0])); for(const row of state.rows) { if(selectedHighest(row)==='unreported') counts.unreported+=weight(row); for(const stage of selectedStages(row)) if(stage in counts) counts[stage]+=weight(row); }
      const total=state.rows.reduce((sum,row) => sum+weight(row),0); $('stack').replaceChildren(); $('legend').replaceChildren();
      const selected=el('div','segment'); selected.style.width=(total ? counts[target]/total*100 : 0)+'%'; selected.style.background='var('+COLORS[target]+')'; selected.title=LABELS[target]+': '+fmt(counts[target]); $('stack').append(selected);
      for(const stage of STAGES) {
        const color='var(' + COLORS[stage] + ')';
        const item=el('span','legend-item'), swatch=el('span','swatch'); swatch.style.background=color; item.append(swatch,document.createTextNode(LABELS[stage] + ' '),el('strong','',fmt(counts[stage]))); $('legend').append(item);
      }
      $('stack').setAttribute('aria-label',LABELS[target]+': '+fmt(counts[target])+' of '+fmt(total)+($('weight').value==='lines' ? ' body lines' : ' definitions')+' have an exact current stage observation');
      const banks=new Map(); for(const row of state.rows) { if(!banks.has(row.bank)) banks.set(row.bank,[]); banks.get(row.bank).push(row); }
      $('banks').replaceChildren();
      for(const [bank,rows] of banks) {
        const bankTotal=rows.reduce((sum,row) => sum+weight(row),0), done=rows.filter(row => selectedStages(row).has(target)), doneWeight=done.reduce((sum,row) => sum+weight(row),0);
        const button=el('button','bank' + (doneWeight ? '' : ' bank-empty')); button.type='button'; button.setAttribute('aria-pressed',String($('bank').value===bank)); button.setAttribute('aria-label','Bank '+bank+': '+fmt(done.length)+' of '+fmt(rows.length)+' definitions reported at selected milestone; filter bank');
        const header=el('div','bank-label'); header.append(el('strong','','Bank ' + bank),el('span','bank-percent',percent(doneWeight,bankTotal)));
        const bar=el('div','bank-bar'), fill=el('div','bank-fill'); fill.style.width=(bankTotal ? doneWeight/bankTotal*100 : 0)+'%'; bar.append(fill);
        button.append(header,bar,el('div','bank-count',fmt(done.length)+' / '+fmt(rows.length)+' definitions'+($('weight').value==='lines' ? ' · line weighted' : '')));
        button.addEventListener('click',() => { $('bank').value=$('bank').value===bank ? '' : bank; state.page=0; renderOverview(); renderList(); }); $('banks').append(button);
      }
    }
    function matches(row) {
      const query=$('search').value.trim().toLowerCase(), stage=$('stage').value;
      if(query && ![row.symbol,row.original_address,row.source].some(value => String(value || '').toLowerCase().includes(query))) return false;
      if($('bank').value && row.bank!==$('bank').value) return false;
      if($('subsystem').value && row.subsystem!==$('subsystem').value) return false;
      if(stage==='remaining' && selectedStages(row).has($('milestone').value)) return false;
      if(stage==='stale' && (!row.updates.some(update => (!$('context').value || contextOf(update)===$('context').value) && stale(update)) || selectedUpdates(row).length)) return false;
      if(stage && stage!=='remaining' && stage!=='stale' && selectedHighest(row)!==stage) return false;
      if($('context').value && stage!=='remaining' && stage!=='unreported' && !row.updates.some(update => contextOf(update)===$('context').value)) return false;
      if($('agent').value && !row.updates.some(update => update.agent===$('agent').value)) return false;
      if($('scope').value && !row.updates.some(update => update.scope===$('scope').value)) return false;
      return true;
    }
    function jump(symbol) { $('search').value=symbol; $('bank').value=''; $('subsystem').value=''; $('stage').value=''; $('agent').value=''; $('scope').value=''; state.page=0; state.expanded.add(symbol); renderOverview(); renderList(); $('routines').scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'}); const summary=$('routines').querySelector('summary'); if(summary) summary.focus({preventScroll:true}); }
    function renderRoutine(row) {
      const details=el('details','routine'); details.open=state.expanded.has(row.symbol); const summary=el('summary','routine-summary'); summary.dataset.symbol=row.symbol;
      const name=el('span','routine-name'); name.append(el('span','chevron','›'),el('span','symbol',row.symbol));
      const source=String(row.source).split('/').pop()+':'+fmt(row.line), stage=el('span','routine-stage'); stage.append(badge(selectedHighest(row)));
      summary.append(name,el('span','routine-source muted mono',source),el('span','routine-address muted mono',row.original_address || '—'),el('span','routine-lines number muted',fmt(lines(row))),stage); details.append(summary);
      let built=false;
      const build=() => { if(built) return; built=true; details.append(renderDetail(row)); };
      if(details.open) build();
      details.addEventListener('toggle',() => { if(details.open) { state.expanded.add(row.symbol); build(); } else state.expanded.delete(row.symbol); });
      return details;
    }
    function renderDetail(row) {
      const wrapper=el('div','routine-detail'), left=el('div'), right=el('div'); const source=state.data.source || {};
      left.append(el('h3','detail-title','Original C definition')); const dl=el('dl'); const sourcePath=source.source_root ? row.source : 'https://github.com/snesrev/sm/blob/'+encodeURIComponent(source.revision || 'main')+'/'+row.source+'#L'+row.line; pair(dl,'Source',pathNode(sourcePath,source.source_root,row.source+':'+row.line)); pair(dl,'Address',row.original_address || 'Not recorded'); pair(dl,'Body lines',fmt(lines(row))); pair(dl,'Bank / hint',row.bank+' / '+row.subsystem); pair(dl,'Definition SHA',el('span','digest',row.definition_sha256 || 'Not recorded')); left.append(dl);
      left.append(el('h3','detail-title','Call references · lexical inventory')); const calls=list(row.calls), chips=el('div','chips');
      if(!calls.length) chips.append(el('span','muted','No call references recorded.'));
      for(const call of calls) { if(state.symbols.has(call)) { const button=el('button','chip',call); button.type='button'; button.title='Explore '+call; button.addEventListener('click',() => jump(call)); chips.append(button); } else chips.append(el('span','chip muted',call)); }
      left.append(chips,el('h3','detail-title','Fixture declarations · declared only'));
      const declarations=list(row.declared_in); if(declarations.length) { const paths=el('ul','path-list'); for(const path of declarations) { const item=el('li'); item.append(pathNode(path,state.data.root)); paths.append(item); } left.append(paths); } else left.append(el('p','muted','No fixture declaration recorded.'));
      right.append(el('h3','detail-title','All reported observations · '+fmt(row.updates.length)));
      if(!row.updates.length) right.append(el('p','muted','No agent update names this routine. Its source definition remains in the inventory.'));
      for(const update of row.updates) {
        const card=el('article','observation'), header=el('div','observation-head'); card.dataset.stale=String(excluded(update)); header.append(badge(update.stage)); if(superseded(update)) header.append(el('span','stale-tag','Superseded observation · excluded from counts')); else if(stale(update)) header.append(el('span','stale-tag','Stale source / inventory / evidence')); else header.append(el('span','muted',time(update.updated_at))); card.append(header);
        const metadata=el('dl'); pair(metadata,'Agent',update.agent); pair(metadata,'Scope',update.scope); pair(metadata,'Evidence context',contextLabel(contextOf(update))); pair(metadata,'Update',update.id); if(update.commit) pair(metadata,'Commit',el('span','mono',update.commit)); if(stale(update)) { pair(metadata,'Reported at',time(update.updated_at)); pair(metadata,'Source revision',el('span','digest',update.source_revision || 'Not recorded')); pair(metadata,'Inventory SHA',el('span','digest',update.inventory_sha256 || 'Not recorded')); } card.append(metadata);
        if(superseded(update)) { const ids=replacements(update).map(candidate => candidate.id); card.append(el('p','muted','Replaced by '+(ids.join(', ') || 'a retained correction')+'. This observation remains excluded even if replacement evidence later becomes stale.')); }
        const evidence=list(update.evidence); if(evidence.length) { card.append(el('h4','detail-title','Evidence references')); const ul=el('ul','path-list'); for(const item of evidence) { const li=el('li'); li.append(pathNode(item.path,state.data.root)); if(item.sha256) li.append(el('div','digest','SHA-256 '+item.sha256)); ul.append(li); } card.append(ul); } else card.append(el('p','muted','No evidence reference attached.'));
        const limits=list(update.limitations); if(limits.length) { card.append(el('h4','detail-title','Reported limitations')); const ul=el('ul'); for(const limit of limits) ul.append(el('li','',limit)); card.append(ul); }
        right.append(card);
      }
      wrapper.append(left,right); return wrapper;
    }
    function renderList() {
      if(!state.data) return; const rows=state.rows.filter(matches), pages=Math.max(1,Math.ceil(rows.length/PAGE_SIZE)); state.page=Math.min(state.page,pages-1);
      const active=document.activeElement, focused=active && active.dataset ? active.dataset.symbol : null;
      $('routines').replaceChildren(); const start=state.page*PAGE_SIZE; for(const row of rows.slice(start,start+PAGE_SIZE)) $('routines').append(renderRoutine(row));
      if(!rows.length) $('routines').append(el('div','empty','No routines match these filters. Reset filters to return to the full inventory.'));
      const result=el('span'); result.append(el('strong','',fmt(rows.length)),document.createTextNode(' of '+fmt(state.rows.length)+' definitions · '+fmt(rows.reduce((sum,row) => sum+lines(row),0))+' body lines')); $('results').replaceChildren(result);
      text('page-info',rows.length ? fmt(start+1)+'–'+fmt(Math.min(start+PAGE_SIZE,rows.length))+' shown' : 'No definitions shown'); text('page',fmt(state.page+1)+' / '+fmt(pages)); $('previous').disabled=state.page===0; $('next').disabled=state.page>=pages-1;
      if(focused) for(const summary of $('routines').querySelectorAll('summary')) if(summary.dataset.symbol===focused) { summary.focus({preventScroll:true}); break; }
    }
    function renderProvenance() {
      const source=state.data.source || {}, dl=el('dl'); pair(dl,'Revision',el('span','mono',source.revision || 'Not recorded')); pair(dl,'Inventory SHA',el('span','digest',source.inventory_sha256 || 'Not recorded')); if(source.identity_sha256) pair(dl,'Identity SHA',el('span','digest',source.identity_sha256)); pair(dl,'Source root',source.source_root || 'Not recorded'); pair(dl,'Inventory scope',typeof source.scope==='string' ? source.scope : JSON.stringify(source.scope || 'Not recorded')); if(source.source_verified_at) pair(dl,'Source checked',time(source.source_verified_at)); pair(dl,'Registry updated',time(state.data.updated_at)); pair(dl,'Agent updates',fmt(state.data.updates.length));
      $('provenance').replaceChildren(dl,el('p','muted','Overview counts each exact reported stage independently. A verified, integrated, or live-exercised update does not automatically count as translated. The routine explorer shows each definition’s highest matching stage for navigation, and its details retain every observation. Stale source, inventory, or evidence observations are excluded from coverage. Checkout at observation describes the source checked when that evidence was recorded; it does not authenticate later edits. Agent and scope filters match any attached update, including stale observations.'),el('p','muted','Body-line weighting estimates the size of source definitions, including their formatting and comments. It measures source inventory, not engineering effort or gameplay completeness. Calls are lexical references; they do not establish complete dependencies or indirect-call coverage. Evidence paths and digests are recorded references, not browser-side verification.'));
    }
    function reset() { for(const id of ['search','bank','subsystem','stage','agent','scope','context']) $(id).value=''; state.page=0; renderOverview(); renderList(); }
    for(const id of ['search','bank','subsystem','stage','agent','scope']) $(id).addEventListener(id==='search' ? 'input' : 'change',() => { state.page=0; if(id==='bank') renderOverview(); renderList(); });
    for(const id of ['milestone','weight','context']) $(id).addEventListener('change',() => { state.page=0; renderOverview(); renderList(); });
    $('reset').addEventListener('click',reset); $('show-remaining').addEventListener('click',() => { $('stage').value='remaining'; state.page=0; renderList(); });
    $('previous').addEventListener('click',() => { state.page=Math.max(0,state.page-1); renderList(); }); $('next').addEventListener('click',() => { state.page++; renderList(); });
    $('load').addEventListener('click',() => $('file').click());
    function showError(error) { text('error',error.message || String(error)); $('error').hidden=false; }
    $('file').addEventListener('change',async () => { const file=$('file').files[0]; if(!file) return; try { const raw=await file.text(); accept(JSON.parse(raw),raw,true); text('checked','Opened: '+file.name); } catch(error) { showError(error); } $('file').value=''; });
    try { const theme=localStorage.getItem('sm-progress-theme'); if(theme==='light' || theme==='dark') document.documentElement.dataset.theme=theme; } catch {}
    $('theme').addEventListener('click',() => { const current=document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light'); const theme=current==='dark' ? 'light' : 'dark'; document.documentElement.dataset.theme=theme; try { localStorage.setItem('sm-progress-theme',theme); } catch {} });
    try { const raw=$('progress-data').textContent; accept(JSON.parse(raw),raw,false); } catch(error) { showError(error); text('results','Open a generated registry JSON to load the inventory.'); }
    async function refresh() {
      if(state.file || document.hidden || !/^https?:$/.test(location.protocol)) return;
      try { const response=await fetch(new URL('registry.json',location.href),{cache:'no-store'}); if(!response.ok) throw new Error('Registry refresh returned HTTP '+response.status+'. The last loaded snapshot is still shown.'); const raw=await response.text(); if(state.file) return; if(raw!==state.raw) accept(JSON.parse(raw),raw,false); state.checked=Date.now(); text('checked','Checked: '+new Date(state.checked).toLocaleTimeString()); $('error').hidden=true; } catch(error) { if(!state.file) showError(error); }
    }
    if(/^https?:$/.test(location.protocol)) { refresh(); setInterval(refresh,7000); }
  })();
  </script>
</body>
</html>
