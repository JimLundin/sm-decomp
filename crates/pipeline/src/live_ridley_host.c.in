extern int32_t port_ridley_frame(uint8_t*,size_t,const uint8_t*,size_t,uint16_t*,size_t,uint32_t);
static unsigned port_ridley_supported,port_ridley_window;
static unsigned long port_ridley_frame_total,port_ridley_frame_c,port_ridley_frame_rust,port_ridley_frame_refused;
static unsigned long port_ridley_active_c,port_ridley_active_rust;
static const uint32 port_ridley_opcodes[8]={0xa6e517,0xa6e4d2,0xa6e4be,0xa6e4ca,0xa6e84d,0xa6e904,0xa6e909,0xa6812f};
static unsigned long port_ridley_opcode_c[8],port_ridley_opcode_rust[8];
static unsigned port_ridley_capture[2][65536];
static unsigned port_ridley_allocation_capture,port_ridley_allocation_material,port_ridley_allocation_id_capture;
static int port_ridley_allocation_active,port_ridley_allocation_executing;
static unsigned PortRidleyWindow(void){return snes_frame_counter<50000?0:1;}
static void PortRidleyCapture(uint16 pc,unsigned window,unsigned capture,const char *phase){
 char name[160];uint16 host[8];uint8 bytes[16];PortProjectileHostSave(host);
 snprintf(name,sizeof(name),"fixtures/ridley-frame-%04x-window%u-%03u-%s.wram",pc,window,capture,phase);
 FILE *f=fopen(name,"wb");if(!f||fwrite(g_ram,1,sizeof(g_ram),f)!=sizeof(g_ram)||fclose(f))exit(2);
 for(unsigned i=0;i<8;i++){bytes[i*2]=host[i];bytes[i*2+1]=host[i]>>8;}
 snprintf(name,sizeof(name),"fixtures/ridley-frame-%04x-window%u-%03u-%s.host",pc,window,capture,phase);
 f=fopen(name,"wb");if(!f||fwrite(bytes,1,sizeof(bytes),f)!=sizeof(bytes)||fclose(f))exit(2);
}
void PortRidleyOpcode(uint32 address,uint32 argument,uint32 returned,uint32 kind,uint32 rust_owned){
 if(!port_ridley_supported)return;
 unsigned index=8;for(unsigned i=0;i<8;i++)if(port_ridley_opcodes[i]==address){index=i;break;}
 if(index==8){fprintf(stderr,"admitted Ridley opcode outside closure\n");exit(4);}
 if(rust_owned)port_ridley_opcode_rust[index]++;else port_ridley_opcode_c[index]++;
 PortEffect(port_effects,"ridley-opcode %u %u %u %u %u\n",port_ridley_window,address,argument,returned,kind);
}
void PortRidleyAllocationBefore(const uint8 *state,const uint16 *host){
 memcpy(g_ram,state,sizeof(g_ram));PortProjectileHostLoad(host);
 port_ridley_allocation_executing=PortProjectileFree();
 port_ridley_allocation_active=port_ridley_allocation_executing;
 port_ridley_allocation_capture=port_ridley_allocation_active&&port_projectile_capture[0]<8?++port_projectile_capture[0]:0;
 port_ridley_allocation_material=port_ridley_allocation_executing&&port_projectile_combat_capture[0]<8?++port_projectile_combat_capture[0]:0;
 port_ridley_allocation_id_capture=0;
 if(port_ridley_allocation_executing){port_projectile_alloc_total[0]++;if(port_projectile_alloc_capture[0]<2){port_ridley_allocation_id_capture=++port_projectile_alloc_capture[0];PortProjectileAllocCapture(0,port_ridley_allocation_id_capture,"before");}}
 if(port_ridley_allocation_capture)PortProjectileCapture(1,port_ridley_allocation_capture,0,"before");
 if(port_ridley_allocation_material)PortProjectileCapture(1,port_ridley_allocation_material,1,"before");
}
void PortRidleyAllocationAfter(const uint8 *state,const uint16 *host){
 memcpy(g_ram,state,sizeof(g_ram));PortProjectileHostLoad(host);
 port_projectile_total[0]++;port_projectile_rust[0]++;
 port_projectile_active_rust[0]+=port_ridley_allocation_active;port_projectile_9642_rust[0]+=port_ridley_allocation_executing;
 if(port_ridley_allocation_executing)port_projectile_alloc_rust[0]++;
 if(port_ridley_allocation_id_capture)PortProjectileAllocCapture(0,port_ridley_allocation_id_capture,"after");
 if(port_ridley_allocation_capture)PortProjectileCapture(1,port_ridley_allocation_capture,0,"after");
 if(port_ridley_allocation_material)PortProjectileCapture(1,port_ridley_allocation_material,1,"after");
 PortEffect(port_effects,"projectile 1 38466 %u\n",GET_WORD(g_ram+0x7820));
}
void PortRidleyInstructions(void (*native)(void)){
 uint16 host[8];PortProjectileHostSave(host);
 int32 support=port_ridley_frame(g_ram,sizeof(g_ram),g_rom,g_snes->cart->romSize,host,8,0);
 if(support!=-2&&support<0){fprintf(stderr,"Ridley support error\n");exit(4);}
 uint16 slot=GET_WORD(g_ram+0xe54);uint16 pc=slot<0x800?GET_WORD(g_ram+0xf92+slot):0;
 int active=support==0&&!(GET_WORD(g_ram+0xf8a+slot)&4)&&GET_WORD(g_ram+0xf94+slot)==1;
 unsigned window=PortRidleyWindow();unsigned capture=support==0&&port_ridley_capture[window][pc]<2?++port_ridley_capture[window][pc]:0;
 if(capture)PortRidleyCapture(pc,window,capture,"before");
 port_ridley_supported=support==0;port_ridley_window=window;port_ridley_frame_total++;
 if(port_mixed&&support==0){
  int32 result=port_ridley_frame(g_ram,sizeof(g_ram),g_rom,g_snes->cart->romSize,host,8,1);
  if(result<0){fprintf(stderr,"accepted Ridley frame error\n");exit(4);}PortProjectileHostLoad(host);
  port_ridley_frame_rust++;port_ridley_active_rust+=active;
 }else{port_ridley_frame_c++;port_ridley_frame_refused+=port_mixed;port_ridley_active_c+=active;native();}
 port_ridley_supported=0;
 if(capture)PortRidleyCapture(pc,window,capture,"after");
}
static void PortRidleyCounters(void){
 printf("frame-hit ProcessEnemyInstructions %lu %lu %lu %lu %lu %lu\n",port_ridley_frame_total,port_ridley_frame_c,port_ridley_frame_rust,port_ridley_frame_refused,port_ridley_active_c,port_ridley_active_rust);
 for(unsigned i=0;i<8;i++)printf("ridley-opcode-hit %u %lu %lu\n",port_ridley_opcodes[i],port_ridley_opcode_c[i],port_ridley_opcode_rust[i]);
}
