unsafe extern "C" {
 fn PortRidleyOpcode(address:u32,argument:u32,returned:u32,kind:u32,rust_owned:u32);
 fn PortRidleyAllocationBefore(ram:*const u8,host:*const u16);
 fn PortRidleyAllocationAfter(ram:*const u8,host:*const u16);
}
#[unsafe(no_mangle)]
pub unsafe extern "C" fn port_ridley_frame(ram:*mut u8,len:usize,rom:*const u8,rom_len:usize,host:*mut u16,host_len:usize,execute:u32)->i32 {
 if ram.is_null() || len!=WRAM_SIZE || rom.is_null() || rom_len==0 || rom_len>0x400000 || host.is_null() || host_len!=8 || (host as usize)%2!=0{return -1;}
 let Some(rend)=(ram as usize).checked_add(len)else{return -1;};
 let Some(oend)=(rom as usize).checked_add(rom_len)else{return -1;};
 let Some(hend)=(host as usize).checked_add(16)else{return -1;};
 if (ram as usize)<oend && (rom as usize)<rend || (host as usize)<rend && (ram as usize)<hend || (host as usize)<oend && (rom as usize)<hend{return -1;}
 let rom=unsafe{std::slice::from_raw_parts(rom,rom_len)};
 let supported=unsafe{live_transaction::inspect(ram,|state|{
  if !memory::ridley_enemy_instructions::supports_call(state,rom,"ProcessEnemyInstructions",0,0)?{return Ok(None);}
  Ok(Some(state.word(0xf78+usize::from(state.word(0xe54))+0x12)&4!=0))
 })};
 let frozen=match supported{Ok(Some(frozen))=>frozen,Ok(None)=>return -2,Err(_)=>return -1};
 if execute==0 || frozen{return 0;}
 let mut context=memory::enemy_projectiles::ProjectileHost::from_words(unsafe{std::ptr::read(host.cast::<[u16;8]>())});
 let result=unsafe{live_transaction::run(ram,|bytes|->Result<(),&'static str>{
  let mut state=Wram::new(bytes)?;
  let slot=state.word(0xe54);
  let enemy=0xf78+usize::from(slot);
  if state.word(enemy+0x12)&4!=0{return Ok(());}
  let timer=state.word(enemy+0x1c);
  state.set_word(enemy+0x1c,timer.wrapping_sub(1));
  if timer!=1{state.set_word(enemy+0x10,state.word(enemy+0x10)&!0x8000);return Ok(());}
  let mut pc=0xa60000|u32::from(state.word(enemy+0x1a));
  for _ in 0..4096{
   let offset=0x130000+(pc as usize&0x7fff);
   let opcode=u16::from_le_bytes(rom.get(offset..offset+2).ok_or("Ridley script extent")?.try_into().unwrap());
   if opcode&0x8000==0{
    let map=u16::from_le_bytes(rom.get(offset+2..offset+4).ok_or("Ridley frame extent")?.try_into().unwrap());
    state.set_word(enemy+0x1c,opcode);state.set_word(enemy+0x16,map);state.set_word(enemy+0x1a,(pc+4)as u16);state.set_word(enemy+0x10,state.word(enemy+0x10)|0x8000);return Ok(());
   }
   let name=match opcode{0xe517=>"Ridley_Instr_1",0xe4be=>"Ridley_Instr_5",0xe4ca=>"Ridley_Instr_6",0xe4d2=>"Ridley_Instr_10",0xe84d=>"Ridley_Instr_11",0xe904=>"Ridley_Instr_12",0xe909=>"Ridley_Instr_13",0x812f=>"EnemyInstr_Sleep",_=>return Err("Ridley admitted unsupported opcode")};
   let argument=pc+2;
   let allocating=matches!(opcode,0xe904|0xe909);
   let bank_offset=opcode==0xe517&&state.word(0x7820)!=0||opcode==0xe4d2&&state.word(0x79f)!=2&&(state.word(0x9c2).wrapping_sub(30)as i16)<0;
   if allocating{state.set_word(0x1995,if opcode==0xe904{0}else{14});live_transaction::observe(&state,|snapshot|{PortRidleyAllocationBefore(snapshot.as_ptr(),context.words().as_ptr());});}
   let returned=memory::ridley_enemy_instructions::dispatch_host(&mut state,rom,&mut context,name,slot.into(),argument as i32)?;
   if allocating{live_transaction::observe(&state,|snapshot|{PortRidleyAllocationAfter(snapshot.as_ptr(),context.words().as_ptr());});}
   let kind=if returned==0{0}else if bank_offset{1}else{2};
   unsafe{PortRidleyOpcode(0xa60000|u32::from(opcode),argument,returned,kind,1);}
   if returned==0{return Ok(());}pc=returned;
  }
  Err("Ridley instruction limit")
 })};
 match result{Ok(())=>{unsafe{std::ptr::write(host.cast::<[u16;8]>(),context.words());}0},Err(_)=>-1}
}
