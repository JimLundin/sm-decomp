uint16 PortActualSpawnHdmaObject(uint8,const void*);
uint16 SpawnHdmaObject(uint8 bank,const void *args) {
 const uint8 *p=args;callbacks++;CallbackSnapshot("before");
 uint16 value=PortActualSpawnHdmaObject(bank,args);CallbackSnapshot("after");
 fprintf(callback_log,"hdma %u %u %u %u %u\n",bank,p[0],p[1],p[2]|p[3]<<8,value);return value;
}
int32_t sm_power_bomb_hdma(uint8_t *ram,size_t len,uint16 script) {
 if(!ram||len!=sizeof(g_ram)||ram==g_ram||(script!=0x8ace&&script!=0x8b80))return -1;
 uint8 args[4]={0x40,script==0x8ace?0x28:0x29,script&255,script>>8};
 memcpy(g_ram,ram,len);uint16 value=SpawnHdmaObject(0x88,args);memcpy(ram,g_ram,len);return value;
}
