 }
 
 void snes_runCycles(Snes* snes, int cycles) {
@@ -237,13 +247,50 @@ static void snes_runCycle(Snes* snes) {
   }
 }
 
-static void snes_catchupApu(Snes* snes) {
-  int64_t perCycle = snes->palTiming ? masterCyclesPerSecondPal : masterCyclesPerSecond;
-  // Truncates toward zero like the upstream (int) cast; the debt goes negative
-  // only by the overrun of the last opcode, and then no cycles are wanted.
-  int catchupCycles = (int) (snes->apuCatchupDebt / perCycle);
-  int ranCycles = apu_runCycles(snes->apu, catchupCycles);
-  snes->apuCatchupDebt -= (int64_t) ranCycles * perCycle;
+int64_t snes_spcCycleWeight(const Snes* snes) {
+  return snes->palTiming ? masterCyclesPerSecondPal : masterCyclesPerSecond;
+}
+
+// The time the SPC has reached, in master clocks times the SPC rate.
+static int64_t snes_spcTime(const Snes* snes) {
+  int64_t rate = snes->palTiming ? apuCyclesPerSecondPal : apuCyclesPerSecond;
+  return (int64_t) snes->cycles * rate - snes->apuCatchupDebt;
+}
+
+// sm-decomp fix 0003: the CPU and the SPC meet at the ports in time order, as
+// bsnes v085's cothreads do. Upstream runs the SPC in whole opcodes until it
+// has passed the CPU, so the opcode that crosses the CPU's access does its port
+// reads and writes early: it reads the CPU's port before the CPU writes it, and
+// the CPU reads what the SPC writes after the access. Here the SPC runs
+// opcodes until it reaches the time of the CPU's access, `lead` before the
+// CPU's current time, but it stops before an opcode that would touch $F4-$F7
+// at or after that time (bsnes lets the CPU go first on a tie). Whether the
+// next opcode does is found by running it on a copy of the SPC registers
+// against side-effect-free memory, only when it starts within an opcode's
+// length of the access. The SPC's own accesses read halfway through its cycle
+// and write at its end, as bsnes v085's SMP does.
+static void snes_catchupApu(Snes* snes, int64_t lead) {
+  // longer than any SPC700 opcode (12 cycles)
+  int64_t window = 16 * snes_spcCycleWeight(snes);
+  while(snes->apuCatchupDebt - lead > 0) {
+    int64_t slack = snes->apuCatchupDebt - lead;
+    if(slack <= window && apu_opcodeMeetsCpu(snes->apu, slack)) break;
+    spc_runOpcode(snes->apu->spc); // apu_cycle pays off the debt
+  }
+}
+
+// An SPC read of port $F4-$F7: the value the CPU had written by the time of the
+// read, halfway through the SPC cycle apu_cycle has just ended.
+uint8_t snes_spcReadPort(Snes* snes, int port) {
+  int64_t time = snes_spcTime(snes) - snes_spcCycleWeight(snes) / 2;
+  return time < snes->apuPortWriteTime[port] ? snes->apuPortBefore[port] : snes->apu->inPorts[port];
+}
+
+// The SPC clears a port through $F1 at the end of its cycle; a CPU write that
+// happened after that keeps its value.
+void snes_spcClearPort(Snes* snes, int port) {
+  if(snes_spcTime(snes) >= snes->apuPortWriteTime[port]) snes->apu->inPorts[port] = 0;
+  snes->apuPortBefore[port] = 0;
 }
 
 static void snes_doAutoJoypad(Snes* snes) {
@@ -268,7 +315,11 @@ uint8_t snes_readBBus(Snes* snes, uint8_t adr) {
     return ppu_read(snes->ppu, adr);
   }
   if(adr < 0x80) {
-    snes_catchupApu(snes); // catch up the apu before reading
+    // fix 0003: bsnes v085 reads 4 master clocks before the end of the access,
+    // LakeSnes runs the whole access first. DMA reads of the ports take the same
+    // timing; Super Metroid does not make them.
+    int64_t rate = snes->palTiming ? apuCyclesPerSecondPal : apuCyclesPerSecond;
+    snes_catchupApu(snes, 4 * rate); // catch up the apu before reading
     return snes->apu->outPorts[adr & 0x3];
   }
   if(adr == 0x80) {
@@ -285,8 +336,14 @@ void snes_writeBBus(Snes* snes, uint8_t adr, uint8_t val) {
     return;
   }
   if(adr < 0x80) {
-    snes_catchupApu(snes); // catch up the apu before writing
-    snes->apu->inPorts[adr & 0x3] = val;
+    snes_catchupApu(snes, 0); // catch up the apu before writing
+    // fix 0003: the write lands at the end of the access, as in bsnes v085; the
+    // old value stays visible to SPC reads made before then.
+    int port = adr & 0x3;
+    int64_t rate = snes->palTiming ? apuCyclesPerSecondPal : apuCyclesPerSecond;
+    snes->apuPortBefore[port] = snes->apu->inPorts[port];
+    snes->apuPortWriteTime[port] = (int64_t) snes->cycles * rate;
+    snes->apu->inPorts[port] = val;
     return;
   }
   switch(adr) {
