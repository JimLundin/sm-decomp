diff --git a/snes/apu.c b/snes/apu.c
index 7c03a2a..d7d26e1 100644
--- a/snes/apu.c
+++ b/snes/apu.c
@@ -104,6 +104,54 @@ static void apu_cycle(Apu* apu) {
   }
 
   apu->cycles++;
+  // fix 0003: pay off the catch-up debt as the SPC runs, so its accesses know
+  // their time against the CPU's
+  apu->snes->apuCatchupDebt -= snes_spcCycleWeight(apu->snes);
+}
+
+// fix 0003: a dry run of the SPC's next opcode. `slack` is how far the CPU's
+// access lies ahead of the SPC, in the debt's scale. The opcode runs on a copy
+// of the registers; reads have no side effects and writes go nowhere. True if
+// it would read or write $F4-$F7 at or after the CPU's access.
+typedef struct ApuProbe {
+  Apu* apu;
+  int64_t slack;
+  int64_t weight;
+  bool meets;
+} ApuProbe;
+
+static bool apu_isPort(uint16_t adr) {
+  return adr >= 0xf4 && adr <= 0xf7;
+}
+
+static uint8_t apu_probeRead(void* mem, uint16_t adr) {
+  ApuProbe* probe = (ApuProbe*) mem;
+  probe->slack -= probe->weight;
+  if(apu_isPort(adr) && probe->slack + probe->weight / 2 <= 0) probe->meets = true;
+  if(adr >= 0xfd && adr <= 0xff) return probe->apu->timer[adr - 0xfd].counter; // without the reset
+  return apu_read(probe->apu, adr);
+}
+
+static void apu_probeWrite(void* mem, uint16_t adr, uint8_t val) {
+  ApuProbe* probe = (ApuProbe*) mem;
+  probe->slack -= probe->weight;
+  if(apu_isPort(adr) && probe->slack <= 0) probe->meets = true;
+}
+
+static void apu_probeIdle(void* mem, bool waiting) {
+  ApuProbe* probe = (ApuProbe*) mem;
+  probe->slack -= probe->weight;
+}
+
+bool apu_opcodeMeetsCpu(Apu* apu, int64_t slack) {
+  ApuProbe probe = {apu, slack, snes_spcCycleWeight(apu->snes), false};
+  Spc copy = *apu->spc;
+  copy.mem = &probe;
+  copy.read = apu_probeRead;
+  copy.write = apu_probeWrite;
+  copy.idle = apu_probeIdle;
+  spc_runOpcode(&copy);
+  return probe.meets;
 }
 
 uint8_t apu_read(Apu* apu, uint16_t adr) {
@@ -157,12 +205,12 @@ void apu_write(Apu* apu, uint16_t adr, uint8_t val) {
         apu->timer[i].enabled = val & (1 << i);
       }
       if(val & 0x10) {
-        apu->inPorts[0] = 0;
-        apu->inPorts[1] = 0;
+        snes_spcClearPort(apu->snes, 0); // fix 0003
+        snes_spcClearPort(apu->snes, 1);
       }
       if(val & 0x20) {
-        apu->inPorts[2] = 0;
-        apu->inPorts[3] = 0;
+        snes_spcClearPort(apu->snes, 2);
+        snes_spcClearPort(apu->snes, 3);
       }
       apu->romReadable = val & 0x80;
       break;
@@ -200,6 +248,7 @@ void apu_write(Apu* apu, uint16_t adr, uint8_t val) {
 uint8_t apu_spcRead(void* mem, uint16_t adr) {
   Apu* apu = (Apu*) mem;
   apu_cycle(apu);
+  if(adr >= 0xf4 && adr <= 0xf7) return snes_spcReadPort(apu->snes, adr - 0xf4); // fix 0003
   return apu_read(apu, adr);
 }
 
