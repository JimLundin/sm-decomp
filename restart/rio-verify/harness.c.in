/* The driver inserts exact recovered bodies before this retained protocol host.
 * Only terrain/angle services below are scripts. Helpers are actual recovered C. */
#include "ida_types.h"
#include "sm_rtl.h"
#include "funcs.h"
#include "enemy_types.h"
#include "variables.h"

uint8 g_ram[0x20000];
const uint8 *g_rom;

/* RECOVERED_BODIES */

static FILE *input;
typedef struct RioFixtureCall { uint8 kind; uint16 k; int32 amount; } RioFixtureCall;
static RioFixtureCall calls[1024];
static uint32 call_count, step_count;
static void fatal(const char *message) { fprintf(stderr, "%s\n", message); exit(2); }
bool Unreachable(void) { fatal("unreachable Rio dispatch"); return false; }
static uint32 read_le(unsigned n) {
  uint32 v = 0;
  for (unsigned i = 0; i < n; i++) { int b = fgetc(input); if (b == EOF) fatal("short fixture"); v |= (uint32)b << (i * 8); }
  return v;
}
static void write_le(FILE *f, uint32 v, unsigned n) {
  for (unsigned i = 0; i < n; i++) if (fputc((v >> (i * 8)) & 255, f) == EOF) fatal("output write failed");
}
static uint16 service(uint8 kind, uint16 k, int32 amount) {
  if (call_count >= step_count || call_count >= 1024) fatal("unexpected service");
  uint8 expected = read_le(1);
  uint16 result = read_le(2);
  uint32 patches = read_le(4);
  if (expected != kind || patches > 0x20000) fatal("service script mismatch");
  calls[call_count++] = (RioFixtureCall){kind, k, amount};
  for (uint32 i = 0; i < patches; i++) {
    uint32 offset = read_le(4); uint8 value = read_le(1);
    if (offset >= sizeof(g_ram)) fatal("patch out of WRAM");
    g_ram[offset] = value;
  }
  return result;
}
uint8 Enemy_MoveRight_IgnoreSlopes(uint16 k, int32 amount) { return service(0, k, amount); }
uint8 Enemy_MoveDown(uint16 k, int32 amount) { return service(1, k, amount); }
uint16 CalculateAngleOfSamusFromEnemy(uint16 k) { return service(2, k, 0); }

int main(int argc, char **argv) {
  if (argc != 4) fatal("usage: reference ROM fixture output");
  FILE *rom = fopen(argv[1], "rb");
  if (!rom || fseek(rom, 0, SEEK_END)) fatal("ROM open failed");
  long size = ftell(rom);
  if (size != 0x300000 || fseek(rom, 0, SEEK_SET)) fatal("ROM size mismatch");
  uint8 *rom_data = malloc(size);
  if (!rom_data || fread(rom_data, 1, size, rom) != (size_t)size) fatal("ROM read failed");
  fclose(rom); g_rom = rom_data;
  input = fopen(argv[2], "rb"); if (!input) fatal("fixture open failed");
  if (read_le(4) != 0x314f4952) fatal("fixture magic mismatch");
  uint32 entry = read_le(4); uint16 k = read_le(2); uint32 arg = read_le(4);
  step_count = read_le(4);
  if (step_count > 1024 || fread(g_ram, 1, sizeof(g_ram), input) != sizeof(g_ram)) fatal("fixture state short");
  uint32 tag = 0, continuation = 0;
  switch (entry) {
    case 0: Rio_Init(); break;
    case 1: Rio_Main(); break;
    case 2: {
      const uint16 *jp = (const uint16 *)RomFixedPtr((0xa20000 | arg));
      const uint16 *result = EnemyInstr_Rio_Instr_1(k, jp);
      tag = 1;
      continuation = (uint32)((const uint8 *)result - RomFixedPtr(0xa28000)) + 0x8000;
      break;
    }
    case 3: Rio_1(k); break;
    case 4: Rio_2(k); break;
    case 5: Rio_3(k); break;
    case 6: Rio_4(k); break;
    case 7: Rio_5(k); break;
    case 8: Rio_6(arg); break;
    case 9: CallRioFunc(arg); break;
    default: fatal("entry outside owned scope");
  }
  if (call_count != step_count || fgetc(input) != EOF) fatal("unconsumed fixture script");
  fclose(input);
  FILE *output = fopen(argv[3], "wb"); if (!output) fatal("output open failed");
  write_le(output, 0x3154554f, 4); write_le(output, tag, 4);
  write_le(output, continuation, 4); write_le(output, call_count, 4);
  write_le(output, step_count, 4);
  if (fwrite(g_ram, 1, sizeof(g_ram), output) != sizeof(g_ram)) fatal("WRAM output failed");
  for (uint32 i = 0; i < call_count; i++) {
    write_le(output, calls[i].kind, 1); write_le(output, calls[i].k, 2); write_le(output, calls[i].amount, 4);
  }
  if (fclose(output)) fatal("output close failed");
  free(rom_data); return 0;
}
