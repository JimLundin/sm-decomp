/.scratch/decomp-port/ridley-hardware-recovery/source/
/.scratch/decomp-port/ridley-natural-recovery/family/
/.scratch/decomp-port/ridley-natural-recovery/snapshots/

# Swarm preparation retains frozen executables locally with build/hash receipts.
/.scratch/decomp-parallel/**/bin/
/.scratch/decomp-parallel/**/helpers/

# Preserve raw command receipts locally and in checkpoint receipt archives.
/.scratch/**/*.stdout
/.scratch/**/*.stderr
/.scratch/**/*.log
/.scratch/**/*.tsv

