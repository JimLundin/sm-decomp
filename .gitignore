/target
# Python tooling caches.
__pycache__/
# Never commit the ROM or anything derived from it.
/rom/*
!/rom/README.md
*.sfc
*.smc
# TAS movie downloads.
/movies/*.bk2
/movies/*.lsmv
/movies/*.inputs
# Save states and logs written by the game.
/saves/
*.smvchk
*.log
# Generated codebase map; keep authored sources only.
/docs/codebase-map/index.html
/docs/codebase-map/atlas-data.json
