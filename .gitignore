/target
/tools/bootstrap/target/
# Downloaded upstream sources, test corpora and emulator binaries.
/deps/
# Never commit the ROM or anything derived from it.
/rom/*
!/rom/README.md
# Ignore legacy output locations as well as the current /out tree.
/crates/game/generated/
/crates/fuzz/generated/
/movies/*.bk2
/movies/*.lsmv
/movies/*.inputs
/out/
*.miss.csv
/lsnes.log
__pycache__/

# Local coordination locks and disposable build/browser directories.
/.scratch/assignment.lock
/.scratch/decomp-progress/registry.json.lock
/.scratch/**/build/
/.scratch/**/target/
/.scratch/**/chromium-profile/

# Captured gameplay runs and frozen evidence readers stay at their sealed paths.
# Small authored source snapshots are backed up by decomp-parallel/checkpoint.
/.scratch/decomp-port/ridley-hardware-recovery/inventory/
/.scratch/decomp-port/ridley-hardware-recovery/controlled/
/.scratch/decomp-port/ridley-hardware-recovery/natural/
/.scratch/decomp-port/ridley-hardware-recovery/bin/
